<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Frontend Mentor | Advice Generator App</title>
  <link rel="icon" type="image/png" sizes="32x32" href="./images/favicon-32x32.png">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/dist/output.css">
</head>

<body class="bg-[#202733] font-['Manrope'] flex items-center justify-center min-h-screen p-4">

  <main class="bg-[#313a48] relative max-w-135 w-full pt-10 pb-16 px-6 md:px-12 rounded-2xl shadow-2xl text-center">

    <p class="text-[#52ffa8] text-[11px] md:text-[13px] tracking-[0.3em] font-extrabold uppercase mb-6">
      Advice #<%= advice.slip.id %>
    </p>

    <h1 class="text-[#cee3e9] text-[24px] md:text-[28px] leading-snug mb-8">
      “<%= advice.slip.advice %>”
    </h1>

    <div class="mb-6">
      <picture>
        <source media="(min-width: 768px)" srcset="./images/pattern-divider-desktop.svg">
        <img src="./images/pattern-divider-mobile.svg" alt="divider" class="mx-auto">
      </picture>
    </div>

    <a href="/"
      class="absolute -bottom-8 left-1/2 -translate-x-1/2 bg-[#52ffa8] hover:shadow-[0_0_40px_rgba(82,255,168,0.8)] p-5 rounded-full transition-all duration-300 cursor-pointer">
      <img src="./images/icon-dice.svg" alt="generate advice" class="w-6 h-6">
    </a>

  </main>

</body>

</html>